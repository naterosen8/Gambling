# Postgres connection string. On Vercel, adding a Neon database sets this for you.
DATABASE_URL=postgres://user:password@localhost:5432/gambling

# The Odds API key (free at https://the-odds-api.com). Leave it out to use sample lines.
ODDS_API_KEY=

# Only for `npm test`: a throwaway database the tests can wipe.
TEST_DATABASE_URL=
